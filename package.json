{
  "name": "portfolia",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "setup": "npm ci && npm run build --workspace=shared && npx playwright install chromium",
    "build": "npm run build --workspace=shared && npm run build --workspace=client",
    "start": "concurrently \"npm run start --workspace=server\" \"npm run preview --workspace=client\"",
    "launcher": "bash scripts/launcher/crea-launcher.sh",
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "typecheck": "tsc --build",
    "typecheck:e2e": "tsc --noEmit -p e2e",
    "lint": "eslint .",
    "check:chiavi": "tsx e2e/support/verifica-chiavi.ts",
    "test": "npm run test --workspace=server",
    "test:e2e-support": "vitest run --root e2e",
    "check": "npm run lint && npm run typecheck && npm run typecheck:e2e && npm run check:chiavi && npm run test:e2e-support && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.11",
    "better-sqlite3": "^11.0.0",
    "concurrently": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.62.0",
    "vitest": "^2.0.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
